# Every secret, key, account or external service credential the project needs.
# Owner: Architect. Agent: read-only.
# The human copies this file to .env (ignored by git) and fills the values; the agent checks .env in phase 0.
# Above each key, one comment line: purpose; environments; provided | test-mode only | not needed.

# PostgreSQL password of the application user; local, production; provided (test uses throwaway containers with a generated password)
DB_PASSWORD=

# Firebase web API key of the real development Firebase project (Q-14a); local manual check, production; provided by the developer or the customer, test-mode only value "fake-api-key" with the emulator
FIREBASE_WEB_API_KEY=
