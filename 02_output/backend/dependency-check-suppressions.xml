<?xml version="1.0" encoding="UTF-8"?>
<!--
  Accepted findings of the OWASP dependency check (SB-08, SR-19). Each one was assessed in the run
  and accepted as a known limitation because its precondition is not reachable in this product:
  servlet MVC with JSON @RestController only; no WebFlux, RSocket, Jetty, WebSocket handshake,
  SSE, XsltView, view templates, SpEL on user input, @ModelAttribute list binding; no LDAP,
  WebAuthn or DPoP (a request with "Authorization: DPoP" is refused, SecurityHeadersIT).
  Evidence: docs/decisions-log.md D-56 (c) and D-70, logs/verify4-backend-dependency-tree.log.
  The fix is the move to Spring Boot 4 / Framework 7.0.9 / Security 7.1 (release notes).
  Only these CVEs and only these versions are suppressed: any new finding still fails the build.
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <suppress>
    <notes>Spring Framework 6.2.19: D-70, not reachable (no free 6.2.x fix; OSS fix 7.0.9).</notes>
    <!-- every Spring Framework 6.2.19 module: the scanner matches these CVEs by product (CPE), not by module -->
    <packageUrl regex="true">^pkg:maven/org\.springframework/spring-[a-z-]+@6\.2\.19$</packageUrl>
    <cve>CVE-2026-47884</cve>
    <cve>CVE-2026-47885</cve>
    <cve>CVE-2026-47886</cve>
    <cve>CVE-2026-47888</cve>
    <cve>CVE-2026-47889</cve>
    <cve>CVE-2026-47890</cve>
    <cve>CVE-2026-47891</cve>
    <cve>CVE-2026-47892</cve>
    <cve>CVE-2026-47893</cve>
    <cve>CVE-2026-59282</cve>
    <cve>CVE-2026-59283</cve>
    <cve>CVE-2026-59313</cve>
  </suppress>
  <suppress>
    <notes>Spring Security 6.5.11: D-56 (c), not reachable (no LDAP, no WebAuthn, DPoP refused).</notes>
    <!-- every Spring Security 6.5.11 module, for the same reason -->
    <packageUrl regex="true">^pkg:maven/org\.springframework\.security/spring-security-[a-z0-9-]+@6\.5\.11$</packageUrl>
    <cve>CVE-2026-41707</cve>
    <cve>CVE-2026-47841</cve>
    <cve>CVE-2026-59270</cve>
  </suppress>
  <suppress>
    <notes>Post-run assessment (2026-11-25, not a decision of the run): CVE-2026-34479 affects
      Log4j1XmlLayout of the Log4j 1-to-Log4j 2 bridge (log4j-1.2-api with log4j-core). Neither is on
      the classpath (logs/verify4-backend-dependency-tree.log: only log4j-api and log4j-to-slf4j,
      which route log4j calls into Logback) and no code uses log4j. Matched only by the product name.</notes>
    <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-api@2\.24\.3$</packageUrl>
    <cve>CVE-2026-34479</cve>
  </suppress>
</suppressions>
