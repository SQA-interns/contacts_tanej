{
  "name": "contact-groups-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web app of Contact Groups (Slovenian and English)",
  "engines": {
    "node": ">=24.13.0",
    "npm": ">=11.6.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "prettier --check . && eslint . && tsc --noEmit && jscpd src",
    "format": "prettier --write .",
    "api:types": "openapi-typescript ../docs/02_contracts/openapi.yaml -o src/lib/api/schema.d.ts",
    "contracts:validate": "node scripts/validate-contracts.mjs",
    "scan": "node scripts/audit.mjs",
    "mutation": "stryker run"
  },
  "overrides": {
    "playwright-core": "1.55.1"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "12.3.0",
    "i18next": "25.5.2",
    "lucide-react": "0.544.0",
    "radix-ui": "1.4.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-i18next": "16.0.0",
    "react-router": "7.18.5",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.13"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/vite": "4.1.13",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.36.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "15.35.0",
    "globals": "17.14.0",
    "jscpd": "4.0.5",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "7.3.8",
    "vitest": "4.1.11"
  }
}
